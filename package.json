{
  "name": "my-agentic-coding-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "aws",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm run dev --workspace @workspace/backend",
    "dev:frontend": "npm run dev --workspace @workspace/frontend",
    "e2e": "npm run e2e --workspace @workspace/frontend",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "npm run build && vitest --run",
    "test:coverage": "npm run build && vitest --run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
